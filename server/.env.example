# ============================================================
# Backend Environment Configuration Template (server/.env.example)
# ============================================================

# --- SERVER CONFIGURATION ---
# Local Dev: 5000 | Production: Provided dynamically by Render (e.g. 10000)
PORT=5000
NODE_ENV=development

# --- DATABASE CONFIGURATION ---
# Local Dev: mongodb://127.0.0.1:27017/codechef_club
# Production (MongoDB Atlas): mongodb+srv://<db_user>:<db_password>@<cluster>.mongodb.net/codechef_club?retryWrites=true&w=majority
MONGO_URI=

# --- AUTHENTICATION & SECURITY ---
# A strong 32+ character random secret string (e.g. generated via `openssl rand -hex 32`)
JWT_SECRET=

# --- CORS CLIENT ORIGIN ---
# Local Dev: http://localhost:5173
# Production (Vercel): https://<your-vercel-app>.vercel.app (comma-separated if multiple domains)
CLIENT_URL=

# --- INITIAL SEED ADMIN SETUP (For running `npm run seed`) ---
ADMIN_EMAIL=
ADMIN_PASSWORD=
