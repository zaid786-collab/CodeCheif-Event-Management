# ============================================================
# Frontend Environment Configuration Template (client/.env.example)
# ============================================================

# Development Mode (uses Vite local proxy configured to http://127.0.0.1:5000):
# VITE_API_URL=/api

# Production Mode (Deployed on Vercel connecting to Render API backend):
# VITE_API_URL=https://<your-render-backend-name>.onrender.com/api

VITE_API_URL=
